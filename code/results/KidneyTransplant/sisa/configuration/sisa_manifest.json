{
  "method": "SISA",
  "configuration": {
    "shards": 5,
    "slices": 5,
    "epochs_per_stage": 3,
    "seed": 42,
    "optimizer_semantics": "fresh Adam optimiser for each slice",
    "checkpoint_semantics": "after_slice_k inherits prior weights and has just trained on slice k only; slice_0 is initialization"
  },
  "dataset_path": "data/processed/KidneyTransplant/kidney_transplant_assessments_clean.csv",
  "dataset_hash": "053bb0f10cc8e34e61a9149221aef77575728a2df8879ce1a0326e5fa025e2d9",
  "dataset_description": "Entirely synthetic longitudinal kidney-transplant follow-up assessments.",
  "target": "acute_rejection_within_30_days",
  "feature_list": [
    "recipient_age",
    "donor_age",
    "donor_type",
    "kidney_failure_cause",
    "previous_transplant",
    "dialysis_months",
    "abo_compatibility_category",
