{
  "schema_version": "qwen-kidney-v3.2-frozen",
  "classifier_features": [
    "recipient_age",
    "donor_age",
    "donor_type",
    "kidney_failure_cause",
    "previous_transplant",
    "dialysis_months",
    "abo_compatibility_category",
    "hla_mismatch_count",
    "antibody_risk_score",
    "cold_ischaemia_hours",
    "days_since_transplant",
    "creatinine_mg_dl",
    "creatinine_change_pct",
    "urine_output_ml_24h",
    "tacrolimus_level_ng_ml",
    "medication_adherence_pct",
    "infection_indicator",
    "previous_rejection"
  ],
  "target": "acute_rejection_within_30_days",
  "grouped_split_key": "recipient_id",
  "excluded_field_classes": [
    "identifiers",
    "audit fields",
    "consent fields",
    "dates",
    "anchors",
    "event controls",
    "hidden generation variables"
  ]
}
